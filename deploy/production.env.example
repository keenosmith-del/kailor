# Store actual values in the host's secret manager, outside the published directory.
NODE_ENV=production
DATABASE_URL=
APP_ORIGIN=https://kailor.co.za
HOST=127.0.0.1
PORT=5050
TRUST_PROXY=loopback
REGISTRATION_POLICY=closed
GUEST_ACCESS=disabled
AI_PROVIDER=mock
AI_ALLOW_REMOTE=false
AI_ALLOW_GUEST_REMOTE=false
ADMIN_EMAIL=
# No seed credentials or remote provider tokens are included here.
# Optional public EmailJS identifiers go in frontend build configuration only
# after owner approval: VITE_EMAILJS_SERVICE_ID / TEMPLATE_ID / PUBLIC_KEY.
