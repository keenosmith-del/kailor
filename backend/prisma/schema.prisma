generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "js"
}
datasource db {
  provider = "postgresql"
}
model AdminUser {
  role String @default("member")
  isGuest Boolean @default(false)
  id String @id @default(uuid())
  email String @unique
  name String?
  passwordHash String
  sessions AuthSession[]
  discoveries DiscoverySession[]
  plans Plan[]
  settings AccountSettings?
  preferences AccountPreference[]
  createdAt DateTime @default(now())
}
model AuthSession {
  tokenHash String @id
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Subject {
  id String @id @default(uuid())
  name String
  synthetic Boolean @default(false)
  sessions DiscoverySession[]
}
model Plan {
  canvasState Json?
  sources ProjectSource[]
  id String @id @default(uuid())
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title String
  description String @default("")
  archivedAt DateTime?
  revision Int @default(0)
  creationKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  sessions DiscoverySession[]
  lastSessionId String?
  lastSession DiscoverySession? @relation("last-session", fields: [lastSessionId], references: [id], onDelete: SetNull)
  selections AccountSettings[]
  @@unique([id, adminId])
  @@unique([adminId, creationKey])
  @@index([adminId, archivedAt, updatedAt])
}
model AccountSettings {
  adminId String @id
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  activePlanId String?
  activePlan Plan? @relation(fields: [activePlanId], references: [id], onDelete: SetNull)
  revision Int @default(0)
}
model AccountPreference {
  id String @id @default(uuid())
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  key String
  value String
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([adminId, key])
}
model ConversationSummary {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  version Int
  knowledgeRevision Int
  sourceRevision Int
  fromOrdinal Int
  throughOrdinal Int
  content Json
  strategy String @default("structured-excerpts-v2")
  superseded Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([sessionId, version])
  @@index([sessionId, superseded, knowledgeRevision])
}
model PlanActionProposal {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceMessageId String
  sourceRevision Int
  title String
  description String
  kind String @default("new_plan")
  status String @default("pending")
  createdAt DateTime @default(now())
  decidedAt DateTime?
  @@index([sessionId, status])
}
model DiscoverySession {
  title String @default("New conversation")
  id String @id @default(uuid())
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id])
  planId String
  plan Plan @relation(fields: [planId, adminId], references: [id, adminId])
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  definitionVersion String
  revision Int @default(0)
  // Advances only when authoritative answers/response states change.
  knowledgeRevision Int @default(0)
  // Revision-bound derived context and stable deterministic question plan.
  contextState Json?
  planState Json?
  synthetic Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  answers DiscoveryAnswer[]
  messages ConversationMessage[]
  evidence Evidence[]
  assessments Assessment[]
  simulations SimulationRun[]
  usage AiUsageRecord[]
  lastForPlans Plan[] @relation("last-session")
  summaries ConversationSummary[]
  planProposals PlanActionProposal[]
  @@index([planId, updatedAt])
  @@unique([id, planId, adminId])
}
model DiscoveryAnswer {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  value Json
  skipped Boolean @default(false)
  responseState String @default("answered")
  quality Json?
  updatedAt DateTime @updatedAt
  @@unique([sessionId, questionId])
}
model ConversationMessage {
  hiddenFromTranscript Boolean @default(false)
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role String
  ordinal Int
  intent String @default("discussion")
  excludedFromContext Boolean @default(false)
  content String
  provider String
  createdAt DateTime @default(now())
  @@unique([sessionId, ordinal])
}
model Evidence {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key String
  value Json
  status String @default("inferred")
  source String
  active Boolean @default(true)
  provenance Json?
  createdAt DateTime @default(now())
  @@index([sessionId, active])
}
model Assessment {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionRevision Int
  knowledgeRevision Int @default(0)
  status String @default("draft")
  summary String
  createdAt DateTime @default(now())
  recommendations Recommendation[]
  report ReportSnapshot?
  @@unique([sessionId, sessionRevision])
  @@index([sessionId, knowledgeRevision])
}
model Service {
  id String @id
  name String
  delivery String
  description String
  hoursLow Int?
  hoursHigh Int?
  recommendations Recommendation[]
}
model Recommendation {
  id String @id @default(uuid())
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  problem String
  solution String
  evidence Json
  benefits Json
  alternatives Json
  complexity String
  dependencies Json
  confidence String
  delivery String
  nextSteps Json
  optional Boolean @default(false)
  estimate CostEstimate?
}
model CostEstimate {
  id String @id @default(uuid())
  recommendationId String @unique
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  status String @default("manual_review")
  currency String
  implementationLow Float?
  implementationHigh Float?
  recurringStatus String @default("vendor_quote_required")
  notes String
}
model ReportSnapshot {
  id String @id @default(uuid())
  assessmentId String @unique
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  content Json
  createdAt DateTime @default(now())
}
model ScenarioTemplate {
  id String @id
  title String
  industry String
  definition Json
}
model SimulationRun {
  id String @id @default(uuid())
  personaId String
  persona Json
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  discoveryPath Json
  assessmentId String?
  evaluationNotes String
  approvalStatus String @default("pending")
  createdAt DateTime @default(now())
  cases CaseIntelligenceRecord[]
}
model CaseIntelligenceRecord {
  id String @id @default(uuid())
  sourceType String
  sourceRunId String?
  sourceRun SimulationRun? @relation(fields: [sourceRunId], references: [id])
  reviewStatus String @default("pending")
  title String
  // Sanitized reusable knowledge only; never copy private session data here.
  pattern Json
  reviewNotes String?
  reviewedAt DateTime?
  reviewVersion Int @default(0)
  createdAt DateTime @default(now())
}
model AiUsageRecord {
  id String @id @default(uuid())
  sessionId String
  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  provider String
  mode String
  status String
  reservedTokens Int
  reason String?
  createdAt DateTime @default(now())
  @@index([createdAt, provider])
}
model AuditEvent {
  id String @id @default(uuid())
  actorId String
  action String
  entityId String
  details Json
  createdAt DateTime @default(now())
}

model AccountInvite {
  tokenHash String @id
  email String
  expiresAt DateTime
  usedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
}

model ProjectSource {
  id String @id @default(uuid())
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title String
  kind String
  content String
  url String?
  status String
  createdAt DateTime @default(now())
  @@index([planId, createdAt])
}
