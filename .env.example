DATABASE_URL=postgresql://kailor:kailor_local@localhost:5432/kailor
PORT=5050
TRUST_PROXY=none
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
# closed (default), invite (server-enforced email-bound single-use code), public (explicit opt-in)
REGISTRATION_POLICY=closed
# Guest access is disabled during controlled testing. Isolated guest tests may explicitly enable it.
GUEST_ACCESS=disabled
ADMIN_EMAIL=founder@kailor.local
# Required: choose at least 12 characters before seeding. Never use production credentials here.
ADMIN_PASSWORD=
AI_PROVIDER=mock
AI_ALLOW_REMOTE=false
# Guest inference uses the same provider, quotas and privacy checks.
AI_ALLOW_GUEST_REMOTE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
AI_MAX_CALLS_PER_SESSION=5
AI_MAX_CALLS_PER_DAY=20
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=15000
AI_CONTEXT_RECENT_MESSAGES=12
AI_CONTEXT_MAX_CHARACTERS=12000
# Optional consultant inputs. No default market prices.
ESTIMATE_CURRENCY=ZAR
ESTIMATE_HOURLY_RATE=
