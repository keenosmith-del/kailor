# Public EmailJS identifiers, consumed by Vite at frontend build time.
# Copy to frontend/.env.local for local use, or provide in the release build environment.
# These are public identifiers, not private mail/account credentials.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# The existing template contract is from_name, reply_to, subject and message.
# Confirm recipient, template mapping and permitted website origins in EmailJS.
# Client validation and public keys do not provide comprehensive spam protection.
