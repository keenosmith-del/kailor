{
  "name": "kailor",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w shared && npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config backend/prisma.config.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "format": "prettier --write backend/src/*.ts backend/tests/*.ts backend/prisma/*.ts frontend/src shared/src data scripts/*.ts docs README.md *.json",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evaluate:live": "node --import tsx scripts/evaluate-live.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
